/* ---------- Waveform canvases ---------- */
function wave(id,color,amp,speed){
  const c=document.getElementById(id),ctx=c.getContext('2d');
  function resize(){c.width=c.offsetWidth*2;c.height=220;}
  resize();window.addEventListener('resize',resize);
  (function draw(t){
    ctx.clearRect(0,0,c.width,c.height);
    ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=3;
    for(let x=0;x<c.width;x+=3){
      const y=c.height/2+Math.sin(x*.02+t*speed)*amp*Math.sin(x*.005+t*speed*.6)
              +(Math.random()-.5)*amp*.4;
      x===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    }
    ctx.stroke();requestAnimationFrame(draw);
  })(0);
}
wave('wave1','#00ff9d',40,.02);
wave('wave2','#ff4d6d',70,.05);

/* ---------- Animated counters ---------- */
document.querySelectorAll('[data-count]').forEach(el=>{
  new IntersectionObserver((e,o)=>{if(e[0].isIntersecting){
    let n=0,target=+el.dataset.count;
    const i=setInterval(()=>{n+=Math.ceil(target/40);
      if(n>=target){n=target;clearInterval(i)}el.textContent=n;},30);
    o.disconnect();}},{threshold:.6}).observe(el);
});

/* ---------- Scroll reveal ---------- */
const ro=new IntersectionObserver(es=>es.forEach(e=>{
  if(e.isIntersecting){e.target.classList.add('show');ro.unobserve(e.target);}}),{threshold:.15});
document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));

/* ---------- Risk engine demo ---------- */
const scenarios={
  human:{score:8,label:'AUTHENTIC',color:'#00ff9d',
