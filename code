<style>
  :root{
    --bg:#0a0e17; --bg2:#0f1524; --card:#141b2e; --card2:#1a2338;
    --cyan:#00e5ff; --green:#00ff9d; --red:#ff4d6d; --amber:#ffc857;
    --text:#e8eefc; --muted:#8b98b8; --border:#243050;
    --grad:linear-gradient(135deg,#00e5ff,#7c4dff);
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);overflow-x:hidden}
  a{text-decoration:none;color:inherit}
  section{padding:90px 7%}

  /* ===== NAV ===== */
  nav{position:fixed;top:0;width:100%;z-index:100;display:flex;justify-content:space-between;
      align-items:center;padding:16px 7%;background:rgba(10,14,23,.85);backdrop-filter:blur(12px);
      border-bottom:1px solid var(--border)}
  .logo{font-size:1.35rem;font-weight:800;display:flex;align-items:center;gap:10px}
  .logo .shield{width:34px;height:34px;background:var(--grad);border-radius:9px;
      display:grid;place-items:center;font-size:1.1rem}
  .logo b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  nav ul{display:flex;gap:28px;list-style:none}
  nav ul a{color:var(--muted);font-size:.92rem;font-weight:600;transition:.3s}
  nav ul a:hover{color:var(--cyan)}
  .nav-cta{background:var(--grad);color:#fff!important;padding:9px 20px;border-radius:8px}
  .burger{display:none;font-size:1.5rem;cursor:pointer;background:none;border:none;color:var(--text)}

  /* ===== HERO ===== */
  .hero{min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr;gap:50px;
       align-items:center;padding-top:140px;position:relative}
  .hero::before{content:'';position:absolute;inset:0;
      background:radial-gradient(700px circle at 80% 20%,rgba(124,77,255,.18),transparent),
                 radial-gradient(600px circle at 15% 70%,rgba(0,229,255,.13),transparent);pointer-events:none}
  .tag{display:inline-block;padding:7px 16px;border:1px solid var(--cyan);color:var(--cyan);
      border-radius:100px;font-size:.78rem;font-weight:700;letter-spacing:1.5px;margin-bottom:22px}
  .hero h1{font-size:clamp(2.1rem,4.2vw,3.4rem);line-height:1.15;font-weight:800;margin-bottom:20px}
  .hero h1 span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{color:var(--muted);font-size:1.05rem;line-height:1.7;max-width:520px;margin-bottom:32px}
  .btns{display:flex;gap:16px;flex-wrap:wrap}
  .btn{padding:14px 30px;border-radius:10px;font-weight:700;font-size:.95rem;transition:.3s;cursor:pointer;border:none}
  .btn-primary{background:var(--grad);color:#fff;box-shadow:0 8px 30px rgba(0,229,255,.3)}
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,229,255,.45)}
  .btn-ghost{background:transparent;color:var(--cyan);border:1.5px solid var(--cyan)}
  .btn-ghost:hover{background:rgba(0,229,255,.1)}

  /* Waveform visual */
  .wave-box{background:var(--card);border:1px solid var(--border);border-radius:18px;
      padding:26px;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.5)}
  .wave-box .lbl{display:flex;justify-content:space-between;font-size:.75rem;
      color:var(--muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}
  canvas{width:100%;height:110px;display:block;border-radius:8px}
  .verdict{margin-top:16px;padding:14px 18px;border-radius:10px;font-weight:700;
      display:flex;justify-content:space-between;align-items:center;font-size:.95rem}
  .verdict.safe{background:rgba(0,255,157,.1);border:1px solid rgba(0,255,157,.4);color:var(--green)}
  .verdict.fake{background:rgba(255,77,109,.12);border:1px solid rgba(255,77,109,.5);color:var(--red)}
  .verdict button{background:none;border:1px solid currentColor;color:inherit;padding:6px 14px;
      border-radius:7px;cursor:pointer;font-weight:700;font-size:.8rem}

  /* ===== STATS ===== */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:50px 7%;
      background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .stat{text-align:center}
  .stat h3{font-size:2.4rem;font-weight:800;background:var(--grad);
      -webkit-background-clip:text;background-clip:text;color:transparent}
  .stat p{color:var(--muted);font-size:.85rem;margin-top:6px}

  /* ===== SECTION HEADINGS ===== */
  .head{text-align:center;margin-bottom:60px}
  .head .kicker{color:var(--cyan);font-size:.8rem;font-weight:700;letter-spacing:2px;text-transform:uppercase}
  .head h2{font-size:clamp(1.7rem,3vw,2.5rem);font-weight:800;margin-top:10px}
  .head p{color:var(--muted);max-width:650px;margin:14px auto 0;line-height:1.7}

  /* ===== PROBLEM ===== */
  .prob-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px}
  .prob-card{background:var(--card);border:1px solid var(--border);border-radius:16px;
      padding:30px;transition:.3s}
  .prob-card:hover{transform:translateY(-6px);border-color:var(--red)}
  .prob-card .ico{font-size:2rem;margin-bottom:16px}
  .prob-card h3{font-size:1.1rem;margin-bottom:10px}
  .prob-card p{color:var(--muted);font-size:.9rem;line-height:1.6}

  /* ===== SOLUTION / 3 PILLARS ===== */
  .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .pillar{background:linear-gradient(180deg,var(--card),var(--card2));border:1px solid var(--border);
      border-radius:18px;padding:36px 28px;text-align:center;position:relative;overflow:hidden;transition:.3s}
  .pillar:hover{transform:translateY(-6px)}
  .pillar::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
  .pillar .badge{position:absolute;top:14px;right:14px;background:rgba(0,255,157,.15);color:var(--green);
      font-size:.65rem;font-weight:800;padding:4px 10px;border-radius:100px;letter-spacing:1px}
  .pillar .ico{font-size:2.6rem;margin-bottom:18px}
  .pillar h3{font-size:1.25rem;margin-bottom:12px}
  .pillar p{color:var(--muted);font-size:.9rem;line-height:1.65}

  /* ===== ARCHITECTURE ===== */
  .arch{background:var(--card);border:1px solid var(--border);border-radius:18px;
      padding:40px;max-width:900px;margin:0 auto;font-family:'Consolas','Courier New',monospace;
      font-size:.8rem;line-height:1.5;overflow-x:auto;white-space:pre;color:var(--cyan)}
  .arch .hl{color:var(--green);font-weight:700}

  /* ===== FEATURES TABLE ===== */
  .feat-table{width:100%;border-collapse:collapse;background:var(--card);
      border-radius:14px;overflow:hidden;border:1px solid var(--border)}
  .feat-table th{background:var(--card2);padding:16px 20px;text-align:left;font-size:.85rem;
      letter-spacing:1px;text-transform:uppercase;color:var(--cyan)}
  .feat-table td{padding:16px 20px;border-top:1px solid var(--border);font-size:.92rem;vertical-align:top}
  .feat-table td:first-child{font-weight:700;color:var(--text);width:38%}
  .feat-table td:last-child{color:var(--muted)}

  /* ===== DEMO ===== */
  .demo-wrap{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;
      background:var(--card);border:1px solid var(--border);border-radius:20px;padding:44px}
  .gauge{position:relative;width:230px;height:230px;margin:0 auto}
  .gauge svg{transform:rotate(-90deg)}
  .gauge .val{position:absolute;inset:0;display:grid;place-items:center;flex-direction:column}
  .gauge .val b{font-size:3rem;font-weight:800}
  .gauge .val span{color:var(--muted);font-size:.8rem;letter-spacing:1px}
  .demo-controls{display:flex;flex-direction:column;gap:14px}
  .demo-controls h3{font-size:1.2rem}
  .demo-controls p{color:var(--muted);font-size:.88rem;line-height:1.6}
  .chip-row{display:flex;gap:10px;flex-wrap:wrap}
  .chip{padding:10px 18px;border-radius:9px;border:1px solid var(--border);background:var(--bg2);
      color:var(--muted);cursor:pointer;font-weight:700;font-size:.85rem;transition:.25s}
  .chip:hover{border-color:var(--cyan);color:var(--cyan)}
  .chip.active{background:var(--grad);color:#fff;border-color:transparent}
  #demoStatus{padding:14px 18px;border-radius:10px;font-weight:700;font-size:.9rem;
      background:var(--bg2);border:1px solid var(--border);color:var(--muted);min-height:50px}

  /* ===== IMPACT ===== */
  .impact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
  .impact-card{background:var(--card);border:1px solid var(--border);border-radius:14px;
      padding:26px;border-left:3px solid var(--cyan)}
  .impact-card h4{font-size:1.05rem;margin-bottom:8px}
  .impact-card p{color:var(--muted);font-size:.87rem;line-height:1.6}
  .kpis{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:44px}
  .kpi{background:rgba(0,255,157,.08);border:1px solid rgba(0,255,157,.35);color:var(--green);
      padding:12px 22px;border-radius:100px;font-weight:700;font-size:.88rem}

  /* ===== CTA / FOOTER ===== */
  .cta{background:linear-gradient(135deg,rgba(0,229,255,.12),rgba(124,77,255,.12));
      text-align:center;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .cta h2{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;margin-bottom:16px}
  .cta p{color:var(--muted);margin-bottom:30px}
  footer{padding:40px 7%;display:flex;justify-content:space-between;align-items:center;
      flex-wrap:wrap;gap:16px;color:var(--muted);font-size:.85rem}
  footer .links{display:flex;gap:22px}
  footer .links a:hover{color:var(--cyan)}

  /* ===== REVEAL ANIMATION ===== */
  .reveal{opacity:0;transform:translateY(30px);transition:.7s ease}
  .reveal.show{opacity:1;transform:none}

  /* ===== RESPONSIVE ===== */
  @media(max-width:960px){
    .hero{grid-template-columns:1fr;padding-top:120px}
    .pillars{grid-template-columns:1fr}
    .demo-wrap{grid-template-columns:1fr}
    .stats{grid-template-columns:repeat(2,1fr)}
    nav ul{position:fixed;top:66px;right:-%;flex-direction:column;background:var(--bg2);
        width:70%;height:100vh;padding:40px;transition:.35s;border-left:1px solid var(--border)}
    nav ul.open{right:0}
    .burger{display:block}
  }
</style>
