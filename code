  clone:{score:96,label:'CRITICAL',color:'#ff4d6d',
    msg:'🚨 CRITICAL (96/100)! Spectral artifacts + flat prosody detected. Active challenge FAILED to pass. TTS fingerprint: open-source neural TTS. Transaction BLOCKED, incident logged for forensics.'},
  hybrid:{score:62,label:'ELEVATED',color:'#ffc857',
    msg:'⚠️ ELEVATED (62/100). Partial clone suspected (spliced genuine + synthetic audio). Adversarial perturbation injected → artifact spike confirmed. Dynamic verbal challenge issued. Recommend call-back + MFA before any transaction.'}
};
function simulate(type,btn){
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
  btn.classList.add('active');
  const s=scenarios[type];
  const off=628-(628*s.score/100);
  document.getElementById('gaugeArc').style.strokeDashoffset=off;
  const sv=document.getElementById('scoreVal');
  document.getElementById('scoreLbl').textContent=s.label;
  document.getElementById('scoreLbl').style.color=s.color;
  document.getElementById('demoStatus').textContent=s.msg;
  document.getElementById('demoStatus').style.borderColor=s.color;
  let n=0;const step=s.score/25;
  const t=setInterval(()=>{n+=step;if(n>=s.score){n=s.score;clearInterval(t)}
    sv.textContent=Math.round(n);sv.style.color=s.color;},35);
}
